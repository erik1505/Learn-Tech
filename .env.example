# Copy to .env and configure Resend SMTP to deliver messages to real inboxes.
# Create an API key and verify the sender domain in your Resend account.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=no-reply@your-verified-domain.com

# Gateway local do Android; o celular precisa estar acessível pelo backend.
SMS_GATEWAY_URL=http://192.168.1.100:8080/message
SMS_GATEWAY_USERNAME=android-gateway-user
SMS_GATEWAY_PASSWORD=android-gateway-password
